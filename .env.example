GEMINI_API_KEY=
GOOGLE_APPS_SCRIPT_URL=
PASSWORD_RESET_MAIL_SECRET=
APP_BASE_URL=http://127.0.0.1:4173
# Stripe: usa claves sk_test_/pk_test_ para pruebas y cámbialas por sk_live_/pk_live_ en producción.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Social sign-in (server-side secrets; never publish values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MMH_ADMIN_EMAILS=

# WhatsApp Inbox: opt-in only after applying migration 0005 to the intended D1.
WHATSAPP_INBOX_ENABLED=false
# Use existing server-side WhatsApp values; never replace them during inbox setup.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret (different from access token and webhook verification token).
WHATSAPP_APP_SECRET=
# Optional override; leave empty to retain the current WhatsApp model.
WHATSAPP_GEMINI_MODEL=
